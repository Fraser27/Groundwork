# LexGraph configuration. Copy to .env and edit.
#
# Every variable here is read by src/config.py. The CDK app stack sets the same
# names in the deployed task definition, so local and AWS differ only in values.
#
# .env is gitignored. Do not commit a filled-in copy.

# ─── Runtime ──────────────────────────────────────────────────────────────────

# "local" | "dev" | "prod". More than a label: src/config.py REFUSES to start if
# the auth bypass or the review gate is relaxed while this is not "local".
ENVIRONMENT=local

# Port the API and the MCP server listen on. 8000 because AgentCore's MCP contract
# fixes it there, and matching keeps one Dockerfile.
PORT=8000

LOG_LEVEL=INFO

# Which entrypoint the container runs. The API and the MCP server share an image;
# this is the only difference between them.
#   src.api.app:app     — REST control plane + serve path
#   src.mcp.server:app  — MCP tools
APP_MODULE=src.api.app:app

# ─── Ontology ─────────────────────────────────────────────────────────────────

# Domain pack from ontologies/. "legal" is the default; "healthcare" exists to
# prove the platform is not legal-specific. Governing predicates are validated
# against the chosen pack at write time, so switching packs mid-corpus will start
# rejecting writes that previously succeeded.
ONTOLOGY_PACK=legal

# ─── Graph ────────────────────────────────────────────────────────────────────

# Neo4j locally, Neptune in AWS. Both speak openCypher over Bolt.
#   local:    bolt://localhost:7687
#   deployed: bolt://<neptune-writer-endpoint>:8182
GRAPH_URI=bolt://localhost:7687
GRAPH_USER=neo4j

# Only used when GRAPH_IAM_AUTH is false. Empty in AWS: with IAM auth the
# handshake is SigV4-signed and there is no credential to rotate or leak.
GRAPH_PASSWORD=lexgraph-dev

# true in AWS, false against local Neo4j.
GRAPH_IAM_AUTH=false

# Region used to sign the Neptune handshake. Defaults to AWS_DEFAULT_REGION.
GRAPH_REGION=us-east-1

GRAPH_MAX_POOL_SIZE=50

# ─── Vector store ─────────────────────────────────────────────────────────────

# OpenSearch Serverless collection endpoint. Leave EMPTY to disable vector
# retrieval — keyword search over verbatim text still works, which is a degraded
# read path rather than a broken one. There is no local emulator.
VECTOR_ENDPOINT=
VECTOR_COLLECTION=lexgraph-vectors
VECTOR_REGION=us-east-1

# Must match the model the vectors were INGESTED with. A kNN search across two
# dimensionalities does not error; it silently returns nonsense.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Cosine similarity floor and candidate count for the first retrieval stage,
# before graph expansion narrows it to edges we trust.
VECTOR_MIN_SCORE=0.6
VECTOR_TOP_K=20

# ─── Documents ────────────────────────────────────────────────────────────────

# S3 is the only source of truth: Neptune and the vector index are derived and can
# be rebuilt from this bucket. Immutable, versioned, object-locked, KMS-encrypted.
DOCUMENT_BUCKET=
DOCUMENT_KMS_KEY_ID=

# Chunk geometry. Changing these does NOT re-slice existing chunks — assertions
# store absolute char offsets into the text they were extracted from, so old
# citations keep resolving against the old chunking.
CHUNK_CHARS=2000
CHUNK_OVERLAP_CHARS=200

# Vision model that transcribes pages. Separate from EXTRACTION_MODEL on purpose:
# reading words off a page is mechanical and a cheap model does it well, whereas
# judging what a passage means is not. It also describes charts, org charts,
# signature blocks and handwriting, which an OCR service returns nothing for.
OCR_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Rasterisation resolution. Below ~110 small print is transcribed *wrongly*, which is
# worse than failing because it looks like text.
OCR_DPI=150

# Ceiling on one document. One model call per page, so a 400-page bundle is a real
# cost — the limit is here rather than discovered on an invoice.
MAX_DOCUMENT_PAGES=400

# ─── Structured sources ───────────────────────────────────────────────────────

# Comma-separated Glue databases to scan. Only metadata enters the graph; rows are
# queried in place at read time and never copied.
GLUE_DATABASES=

ATHENA_WORKGROUP=primary
ATHENA_RESULTS_BUCKET=

# Ceiling on rows returned from a structured query. A metric that would exceed it
# is answered as an aggregate rather than a truncated table.
MAX_QUERY_ROWS=500

# ─── Auth ─────────────────────────────────────────────────────────────────────

# tenant_id is read from the verified JWT's custom claim and NEVER from a request
# parameter — a caller who could name their own tenant could read another firm's
# privileged material.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER_URL=
COGNITO_REGION=us-east-1

# Amazon Verified Permissions store holding the Cedar policies that decide which
# matters a caller may read.
POLICY_STORE_ID=

# LOCAL DEVELOPMENT ONLY. Serves unauthenticated requests as this tenant so there
# is no need to mint a JWT by hand. src/config.py raises at startup if this is set
# while ENVIRONMENT is not "local" — a deployment honouring it would accept
# anonymous requests as a real customer.
AUTH_DEV_BYPASS_TENANT=dev-tenant

# ─── Models ───────────────────────────────────────────────────────────────────

# Model used for interpretive extraction. Its output is EXTRACTED_MODEL, so it
# goes to the review queue rather than into the graph. Every assertion records the
# model in its `method`, so changing this supersedes rather than mixes generations.
EXTRACTION_MODEL=global.anthropic.claude-sonnet-5

# Model that writes the final answer from retrieved chunks and assertions. It never
# decides what is true — only how to phrase what retrieval already returned.
SYNTHESIS_MODEL=global.anthropic.claude-sonnet-5

BEDROCK_REGION=us-east-1

# ─── Control-plane tables ─────────────────────────────────────────────────────

TENANT_TABLE=
JOB_TABLE=
GRANT_TABLE=

# ─── Governance ───────────────────────────────────────────────────────────────

# Retrieval trust floor. Assertions below it stay visible in the review queue but
# do not shape answers. Narrow it freely; widening it lets low-confidence model
# output become a finding.
MIN_CONFIDENCE=0.8

# The review gate. When true, EXTRACTED_MODEL assertions land in the review queue
# instead of the live graph. src/config.py refuses to start with this off outside
# local development: with it off, an LLM's opinion is indistinguishable from a
# parsed citation, which is the exact failure the assertion contract exists to
# prevent.
REQUIRE_REVIEW_FOR_MODEL_EXTRACTIONS=true

# ─── AWS ──────────────────────────────────────────────────────────────────────

AWS_DEFAULT_REGION=us-east-1

# Credentials for Bedrock from local dev. docker-compose mounts ~/.aws read-only
# rather than copying keys into the environment.
AWS_PROFILE=
