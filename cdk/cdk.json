{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "node_modules", "cdk.out"]
  },
  "context": {
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/core:validateAgainstDefaultRules": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",

    "availabilityZones": ["us-east-1b", "us-east-1c"],

    "webOrigin": "https://d6hndgv187j6s.cloudfront.net",

    "neptuneInstanceClass": "db.t4g.medium",
    "neptuneInstanceCount": 1,
    "neptuneParameterGroupFamily": "neptune1.4",

    "vectorMinOcu": 0,
    "vectorMaxOcu": 4,

    "appDesiredCount": 1,
    "appCpu": 512,
    "appMemoryMiB": 1024,

    "defaultOntology": "fintech",

    "aws-cdk:enableDiffNoFail": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-ecs-patterns:removeDefaultDesiredCount": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentControllerForCircuitBreaker": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true
  }
}
