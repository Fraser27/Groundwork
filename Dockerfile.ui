# Local-dev container only. In AWS the UI is static files on S3 behind CloudFront
# (see cdk/lib/web-stack.ts); nginx here exists so `make up` gives a working
# same-origin /api proxy without CloudFront in the loop.
FROM node:20-slim AS build
WORKDIR /app
COPY ui/package*.json ./
RUN npm ci
COPY ui/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

# Proxying /api to the api service reproduces CloudFront's behaviour, so the
# front-end uses one relative base URL in both environments and needs no CORS.
RUN printf '%s\n' \
  'server {' \
  '    listen 80;' \
  '    root /usr/share/nginx/html;' \
  '    index index.html;' \
  '' \
  '    location / {' \
  '        try_files $uri $uri/ /index.html;' \
  '    }' \
  '' \
  '    location /api/ {' \
  '        proxy_pass http://api:8000/;' \
  '        proxy_set_header Host $host;' \
  '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
  '        proxy_read_timeout 300s;' \
  '    }' \
  '' \
  '    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {' \
  '        expires 1y;' \
  '        add_header Cache-Control "public, immutable";' \
  '    }' \
  '}' \
  > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
